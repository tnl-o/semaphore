{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Group Go dependency updates",
      "matchManagers": ["gomod"],
      "groupName": "Go dependencies",
      "groupSlug": "go-deps",
      "schedule": ["before 10am on monday"],
      "prPriority": 1
    },
    {
      "description": "Group npm dependency updates",
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies"],
      "groupName": "npm dependencies",
      "groupSlug": "npm-deps",
      "schedule": ["before 10am on monday"],
      "prPriority": 1
    },
    {
      "description": "Group npm devDependency updates",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "groupName": "npm devDependencies",
      "groupSlug": "npm-dev-deps",
      "schedule": ["before 10am on monday"],
      "prPriority": 2
    },
    {
      "description": "Auto-merge patch updates for Go",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Auto-merge patch updates for npm",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Security updates should be prioritized",
      "matchManagers": ["gomod", "npm"],
      "matchUpdateTypes": ["security"],
      "prPriority": 10,
      "automerge": false
    },
    {
      "description": "Major version updates require manual review",
      "matchManagers": ["gomod", "npm"],
      "matchUpdateTypes": ["major"],
      "prPriority": 5,
      "automerge": false
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "prPriority": 10
  },
  "schedule": [
    "before 10am on monday"
  ],
  "timezone": "UTC",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "labels": ["dependencies"],
  "assignees": [],
  "reviewers": [],
  "commitMessagePrefix": "chore(deps):",
  "commitMessageAction": "update",
  "commitMessageTopic": "{{depName}}",
  "commitMessageExtra": "to {{newVersion}}",
  "rebaseWhen": "behind-base-branch",
  "rangeStrategy": "update-lockfile"
}
